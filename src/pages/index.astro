---
import { gameUrl } from "../components/game/art-url";
import CareerWalk from "../components/game/CareerWalk.svelte";
import { projects } from "../data/projects";
import { EMAIL, contact, elsewhere, experience, resume } from "../data/resume";
import "@fontsource-variable/instrument-sans/wdth.css";
import "@fontsource/jersey-15/latin-400.css";
import "../styles/base.css";
import "../styles/walk.css";
import "../styles/page.css";
import instrumentSans from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";
import jersey from "@fontsource/jersey-15/files/jersey-15-latin-400-normal.woff2?url";

const badges: [name: string, label: string, href: string, external: boolean][] = [
  ["email", "Email", `mailto:${EMAIL}`, false],
  ["linkedin", "LinkedIn", contact.linkedin.url, true],
  ["github", "GitHub", contact.github.url, true],
  ["pdf", "PDF", "/resume.pdf", false],
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dan Aimone",
  url: contact.site,
  email: `mailto:${EMAIL}`,
  image: `${contact.site}/images/avatar.png`,
  jobTitle: resume.jobs[0].title,
  worksFor: { "@type": "Organization", name: resume.jobs[0].company },
  alumniOf: { "@type": "CollegeOrUniversity", name: resume.education.school },
  address: { "@type": "PostalAddress", addressLocality: "Seattle", addressRegion: "WA" },
  sameAs: elsewhere.map(([, href]) => href),
};

const title = "Dan Aimone | Software Engineer";
const description =
  "Dan Aimone is a software engineer in Seattle, building agentic AI products at Vannevar. Previously Atlassian, Chewy, and Pacific Northwest National Laboratory.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#11111b" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://danaimone.com/" />
    <meta property="og:image" content="https://danaimone.com/og.png?v=2" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dan Aimone's pixel-art avatar and his Samoyed walking under Mount Rainier at golden hour." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={instrumentSans} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jersey} crossorigin />
    <link rel="canonical" href="https://danaimone.com/" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <noscript><style>.walk{height:100svh}.walk-timeline,.walk-hint{display:none}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#resume">Skip to the résumé</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Dan Aimone, home">
        <img src="/images/avatar-mark.png" alt="" width="66" height="66" />
      </a>
      <nav aria-label="Sections">
        <a href="#resume">Résumé</a>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <h1 class="visually-hidden">Dan Aimone</h1>
      <CareerWalk client:load />

      <div class="resume" id="resume" tabindex="-1">
        <article class="sheet">
          <header class="sheet-head">
            <div>
              <h2 class="sheet-name">Dan Aimone</h2>
              <p class="sheet-role">Software Engineer, Seattle</p>
            </div>
            <nav class="badges" aria-label="Links">
              {badges.map(([name, label, href, external]) => (
                <a class="badge" href={href} rel={external ? "me noopener" : undefined} target={name === "pdf" ? "_blank" : undefined}>
                  <span class="badge-icon"><img src={gameUrl(`icons/${name}`)} alt="" width="36" height="36" /></span>
                  <span class="badge-label">{label}</span>
                </a>
              ))}
            </nav>
          </header>

          <section aria-labelledby="experience-title">
            <h3 class="sheet-head-label" id="experience-title">Experience</h3>
            <ol class="log">
              {experience.map(({ id, company, roles }) => (
                <li class={`entry is-${id}`}>
                  <span class="mark">
                    <img src={gameUrl(`logos/${id}`)} alt="" width="28" height="28" loading="lazy" />
                  </span>
                  <div class="entry-body">
                    <h4>{company}</h4>
                    {roles.map((role) => (
                      <div class="role">
                        <div class="role-line">
                          <h5>{role.title}</h5>
                          <p class="years">{role.years}</p>
                        </div>
                        <ul class="bullets">
                          {role.bullets.map((bullet) => <li>{bullet}</li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <div class="sheet-foot">
            <section aria-labelledby="education-title">
              <h3 class="sheet-head-label" id="education-title">Education</h3>
              <p class="school">{resume.education.school}</p>
              <p class="degree">{resume.education.degree} {resume.education.field}</p>
              <p class="years">{resume.education.place}</p>
            </section>
            <section aria-labelledby="skills-title">
              <h3 class="sheet-head-label" id="skills-title">Skills</h3>
              <dl class="skills">
                {resume.skills.map(([label, items]) => (
                  <div>
                    <dt class="pixel">{label}</dt>
                    <dd>{items}</dd>
                  </div>
                ))}
              </dl>
            </section>
          </div>
        </article>

        <div class="after">
          <section class="projects" id="projects" tabindex="-1" aria-labelledby="projects-title">
            <h2 class="sheet-head-label" id="projects-title">Projects</h2>
            <ul class="project-list">
              {projects.map(({ name, href, privateSource, summary, detail, areas, shot, sessions, stack }) => {
                const Card = href ? "a" : "div";
                return (
                  <li class:list={{ "is-wide": areas }}>
                    <Card class="project" href={href} rel={href && "me noopener"}>
                      {shot && <img class="project-shot" src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" />}
                      {sessions && (
                        <div class="project-shot project-sessions" role="img" aria-label="The picker listing four agent sessions by state.">
                          <p aria-hidden="true">Agent Sessions <span>{sessions.length}/{sessions.length}</span></p>
                          <ul aria-hidden="true">
                            {sessions.map(([state, title, where]) => (
                              <li class={`is-${state}`}>
                                <span class="session-title">{title}</span>
                                <span class="session-where">{where}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                      <div class="project-head">
                        <h3 class="pixel">{name}</h3>
                        {href && <span class="project-source pixel" aria-hidden="true">Source →</span>}
                        {privateSource && <span class="project-source pixel">Private</span>}
                      </div>
                      <p class="project-summary">{summary}</p>
                      <p class="project-detail">{detail}</p>
                      {areas && (
                        <dl class="skills project-areas">
                          {areas.map(([label, text]) => (
                            <div>
                              <dt class="pixel">{label}</dt>
                              <dd>{text}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                      <ul class="project-stack" aria-label="Built with">
                        {stack.map((item) => <li>{item}</li>)}
                      </ul>
                    </Card>
                  </li>
                );
              })}
            </ul>
          </section>

          <section id="about" tabindex="-1" aria-labelledby="about-title">
            <h2 class="sheet-head-label" id="about-title">About</h2>
            <div class="about">
              <img class="about-avatar" src="/images/avatar.png" alt="Dan’s pixel-art avatar" width="2084" height="2084" loading="lazy" />
              <div class="prose">
                <p>
                  I’m an AI-native, product-minded engineer who works across the
                  stack, at my best where interface design meets the systems
                  behind it. I’ve built tools at a national lab, large-scale
                  products at Atlassian and Chewy, and now agentic AI at
                  Vannevar.
                </p>
                <p>
                  I like owning a feature from the design doc to the production
                  deploy, and being the one who tracks down why something broke.
                  I live in Seattle with my Samoyed, Mishka. I run a homelab,
                  play guitar and piano, lift, read, and take photos.
                </p>
              </div>
            </div>
          </section>

          <section id="contact" tabindex="-1" aria-labelledby="contact-title">
            <h2 class="sheet-head-label" id="contact-title">Contact</h2>
            <div class="contact">
              <p data-seattle-time hidden></p>
              <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <div class="email-row">
                <button type="button" class="copy copy-email" data-copy-email={EMAIL}>
                  <span aria-live="polite">Copy email</span>
                </button>
                <ul class="elsewhere" aria-label="Elsewhere">
                  {elsewhere.map(([label, href]) => (
                    <li>
                      <a href={href} rel="me noopener" aria-label={label} title={label}>
                        <img src={gameUrl(`icons/${label === "X" ? "x" : label.toLowerCase()}`)} alt="" width="36" height="36" loading="lazy" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>

    <footer class="colophon">
      <p>© {new Date().getFullYear()} Dan Aimone</p>
      <p>Built with Astro, Svelte, and canvas. <a href="https://github.com/danaimone/danaimone.com" rel="me noopener">Source on GitHub</a></p>
    </footer>

    <script>
      import "../scripts/pixel-wipe";

      const clock = document.querySelector<HTMLElement>("[data-seattle-time]");
      const format = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles",
        hour: "numeric",
        minute: "2-digit",
      });
      function showTime() {
        if (!clock) return;
        clock.textContent = `It’s ${format.format(new Date()).toLowerCase()} in Seattle.`;
        clock.hidden = false;
      }
      showTime();
      setInterval(showTime, 30000);

      const copy = document.querySelector<HTMLButtonElement>("[data-copy-email]");
      copy?.addEventListener("click", async () => {
        const label = copy.querySelector("span")!;
        try {
          await navigator.clipboard.writeText(copy.dataset.copyEmail!);
          label.textContent = "Copied";
          setTimeout(() => (label.textContent = "Copy email"), 2400);
        } catch {
          location.href = `mailto:${copy.dataset.copyEmail}`;
        }
      });
    </script>
  </body>
</html>
